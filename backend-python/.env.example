# OpenAI API
OPENAI_API_KEY=sk-your-key-here

# Gemini API (alternative)
GEMINI_API_KEY=your-gemini-key-here
LLM_PROVIDER=openai  # Options: 'openai', 'gemini', 'openrouter'

# OpenRouter API (required if LLM_PROVIDER=openrouter)
# Get your API key from: https://openrouter.ai/keys
# ⚠️ SECURITY: Never commit your actual API key. If exposed, revoke immediately.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-vl-flash:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ComplaintOpsCopilot

# Database
REVIEW_DB_PATH=./reviews.db

# Review Encryption (KVKK/GDPR compliance)
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVIEW_ENCRYPTION_KEY=your-32-byte-fernet-key-here
REVIEW_ENCRYPTION_ENABLED=true

# Retention Policy
REVIEW_RETENTION_DAYS=90

# RAG Configuration
RAG_TOP_K=4
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Logging
LOG_LEVEL=INFO

