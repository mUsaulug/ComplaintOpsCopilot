
# Security Keys (Replace with actual keys)
# NEVER commit the real .env file!
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# LLM Configuration
# Options: openai, gemini, openrouter
LLM_PROVIDER=openai
OPENROUTER_MODEL=xiaomi/mimo-vl-flash:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ComplaintOpsCopilot

# RAG Configuration
RAG_TOP_K=3

# Database Configuration
POSTGRES_DB=complaintops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/complaintops

# Service URLs
AI_SERVICE_URL=http://python-ai:8000
BACKEND_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080

# Optimization & Stability
# 1 = Safe for CPU-only / Low RAM environments
WEB_CONCURRENCY=1
SPACY_MODEL=en_core_web_lg
